[Error]
enum PeatLinkError {
    "StartupError",
    "AlreadyRunning",
    "NotRunning",
    "InternalError",
};

dictionary BlePeerInfo {
    string id;
    string name;
    i8 rssi;
    boolean is_connected;
    u64 last_seen_ms;
    string transport;
};

interface MobileNode {
    [Throws=PeatLinkError]
    constructor(string data_dir, string display_name);

    [Throws=PeatLinkError]
    u16 start(string? web_dir);

    [Throws=PeatLinkError]
    void stop();

    u16 port();
    string node_id();
    string display_name();
    boolean is_running();

    // Settings
    void set_display_name(string name);
    string regenerate_identity();

    // Upstream relay
    [Throws=PeatLinkError]
    void connect_upstream(string url, string room_name);

    [Throws=PeatLinkError]
    void disconnect_upstream();

    boolean is_upstream_connected();

    // BLE mesh controls
    [Throws=PeatLinkError]
    void start_ble(string mesh_id, string callsign, sequence<u8>? shared_secret);

    [Throws=PeatLinkError]
    void stop_ble();

    boolean is_ble_running();

    sequence<BlePeerInfo> ble_peers();

    // BLE platform callbacks (called from Android/iOS native code)
    void on_ble_discovered(string identifier, string? name, i8 rssi, string? mesh_id, u64 now_ms);
    void on_ble_connected(string identifier, u64 now_ms);
    void on_ble_disconnected(string identifier);
    void on_ble_data_received(string identifier, sequence<u8> data, u64 now_ms);

    // BLE tick — call periodically (~3s). Returns data to broadcast to peers, if any.
    sequence<u8>? ble_tick(u64 now_ms);

    // Build current mesh document for new connections
    sequence<u8>? ble_build_document();

    // BLE voice audio relay
    void send_voice_frame(sequence<u8> opus_frame, string sender_id, string sender_name);
    sequence<VoiceFrame> recv_voice_frames();

    // Direct BLE data transport (bypasses peat-btle document sync)
    void push_ble_recv_from(string peer_id, sequence<u8> data);
    void push_ble_recv(sequence<u8> data);
    sequence<u8>? pop_ble_send();

    // Direct BLE peer notifications (bypasses peat-btle event system)
    void notify_ble_peer_connected(string peer_id, string peer_name);
    void notify_ble_peer_disconnected(string peer_id);
};

dictionary VoiceFrame {
    sequence<u8> data;
    string sender_id;
    string sender_name;
    u64 timestamp;
};

namespace peatlink_mobile {
    string peatlink_version();
};
